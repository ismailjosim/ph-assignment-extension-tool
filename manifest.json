{
  "name": "Tools",
  "description": "This extension is made with love and used to help a bit to all of our instructors when they are on the playground - MD. JASIM, SHAKIL & FARHAN ❤️🔥",
  "version": "2.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.programming-hero.com/*",
    "*://meet.google.com/*",
    "*://github.com/*"
  ],
  "action": {
    "default_icon": "fire-love.png",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.programming-hero.com/*",
        "*://meet.google.com/*",
        "*://github.com/*"
      ],
      "css": ["tools.css"],
      "js": [
        "./js/buttons.js",
        "display.js",
        "./js/github.js",
        "./js/meet.js",
        "./js/liveSite.js",
        "./js/instructorPortal.js",
        "app.js"
      ]
    }
  ],
  "manifest_version": 3
}
